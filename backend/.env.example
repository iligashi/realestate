# Copy this file to .env and fill in the values.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/real-estate-marketplace

# JWT: use a long random string, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRE=7d

# Allowed frontend origins for CORS (comma-separated)
FRONTEND_URL=http://localhost:3000

# Logging: debug | info | warn | error | silent (default: debug in development, info in production)
# LOG_LEVEL=info

# Session cookie SameSite policy. Defaults: "lax" in development, "none" in production
# (frontend and API on different domains). Set to "lax" if both share one site.
# COOKIE_SAMESITE=lax
