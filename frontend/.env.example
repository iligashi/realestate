# URL of the backend API server (no trailing slash).
# Leave EMPTY in production when /api and /uploads are proxied to the API
# (see vercel.json) so the session cookie stays on your own domain.
VITE_SERVER_URL=http://localhost:5000

# Real-time (Socket.IO) server, if it differs from VITE_SERVER_URL.
# In production with the Vercel proxy, set this to the API's own URL.
# VITE_SOCKET_URL=

# Error tracking (optional): Sentry DSN for the browser app
# VITE_SENTRY_DSN=
