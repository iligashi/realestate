# Production build settings (not secrets). Vite reads this file for `vite build`.
# Empty = same-origin API: vercel.json proxies /api and /uploads to Render.
VITE_SERVER_URL=
# Live chat connects to the API directly (Vercel cannot proxy WebSockets).
# If Render assigns a different URL, update it here and in vercel.json.
VITE_SOCKET_URL=https://realestate-api.onrender.com
